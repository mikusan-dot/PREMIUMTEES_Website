# ============================================================================
# T-Shirt E-Commerce Platform — Environment Variables (Example)
# ============================================================================
# Copy this file to .env and fill in real values. Never commit .env.
# NEVER put secret keys here that are exposed to the frontend.
# Frontend-safe vars must be prefixed with VITE_ (Vite convention).

# ----------------------------------------------------------------------------
# Firebase (Admin SDK — backend only) & Firebase Auth (admin login)
# Obtain from: Firebase Console → Project Settings → Service Accounts
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef

# ----------------------------------------------------------------------------
# Cloudinary (product images)
# Obtain from: Cloudinary Console → Dashboard
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=your-api-secret

# ----------------------------------------------------------------------------
# Payment Gateway — SSLCOMMERZ sandbox (configure per provider docs)
# Obtain sandbox credentials from SSLCOMMERZ / aamarPay merchant panel
# ----------------------------------------------------------------------------
PAYMENT_GATEWAY=sslcommerz
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
SSLCOMMERZ_SUCCESS_URL=https://yourdomain.com/api/payments/success
SSLCOMMERZ_FAIL_URL=https://yourdomain.com/api/payments/fail
SSLCOMMERZ_CANCEL_URL=https://yourdomain.com/api/payments/cancel
SSLCOMMERZ_IPN_URL=https://yourdomain.com/api/payments/webhook
# Verify IPN signatures using the sandbox validation key provided by the gateway
SSLCOMMERZ_VALIDATION_KEY=your_sandbox_validation_key

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api
SESSION_SECRET=change-this-to-a-long-random-string

# ----------------------------------------------------------------------------
# Business settings (overridable via admin dashboard; defaults below)
# ----------------------------------------------------------------------------
BRAND_NAME=Premium Tees
BRAND_CURRENCY=BDT
DELIVERY_CHARGE_INSIDE_DHAKA=80
DELIVERY_CHARGE_OUTSIDE_DHAKA=150
TAX_PERCENT=0
